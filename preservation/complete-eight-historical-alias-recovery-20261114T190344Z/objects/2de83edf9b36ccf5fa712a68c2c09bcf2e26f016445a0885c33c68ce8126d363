#!/bin/bash
set -euo pipefail
ART=/opt/swccg-wiki/set-art-boxes
mkdir -p "$ART"
UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36'
REF='https://starwars.fandom.com/wiki/Category:Star_Wars_Customizable_Card_Game_sets_and_expansion_packs'
W='https://static.wikia.nocookie.net/starwars/images'

try() {
  local dest="$1"
  shift
  local url
  for url in "$@"; do
    if curl -fsSL -A "$UA" -e "$REF" --max-time 25 -o "$dest.tmp" "$url"; then
      sz=$(wc -c < "$dest.tmp")
      if [ "$sz" -gt 4000 ]; then
        python3 - "$dest.tmp" "$dest" <<'PY'
import sys
from PIL import Image
src, dst = sys.argv[1], sys.argv[2]
Image.open(src).convert("RGB").save(dst, "JPEG", quality=88)
PY
        rm -f "$dest.tmp"
        echo "OK $dest ($(wc -c < "$dest"))"
        return 0
      fi
    fi
    rm -f "$dest.tmp"
  done
  echo "FAIL $dest"
}

# Filenames from Wookieepedia category Star Wars Customizable Card Game sets and expansion packs
